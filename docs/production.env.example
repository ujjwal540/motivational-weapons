# Production environment template
# Copy these values into Vercel environment variables.

# App
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

# Leave this unset in production
NEXT_PUBLIC_USE_FAKE_AUTH=

# Supabase Postgres
# Use your own Supabase password here.
DATABASE_URL="postgresql://postgres:[PASSWORD]@nopnqmeqxsewnpvruqrv.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@nopnqmeqxsewnpvruqrv.supabase.co:5432/postgres"

# Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Coach
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile